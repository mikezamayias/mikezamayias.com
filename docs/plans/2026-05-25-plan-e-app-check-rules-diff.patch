diff --git a/firebase/firestore.rules b/firebase/firestore.rules
--- a/firebase/firestore.rules
+++ b/firebase/firestore.rules
@@ -67,52 +67,59 @@
       allow create, update, delete: if isAdmin();
     }

     // ----- Singletons (hero/about/roadmap) -----
     match /singletons/{name} {
-      allow get: if true; // Always public — these power the public site
+      // Plan E: App Check enforced. Real visitors still read (their
+      // browser attests via reCAPTCHA Enterprise); scrapers without a
+      // token are denied. `request.app == null` denies pre-enforcement.
+      allow get: if request.app != null;
       allow list: if false; // No listing — clients read by ID
       allow create, update, delete: if isAdmin();
     }

     // ----- PR #66 collections — admin write via server endpoints. Public
     //       read of `social` + `experience` + `skills` + `education` +
     //       `certifications` + `contact/main` is allowed since they appear on
     //       the public /about page; `profile/main` is admin-only because it
     //       holds the canonical email + phone (Plan B Task 0.5 also removes
     //       it from the server-side public allowlist).
     match /profile/{name} {
       allow read: if isAdmin();
       allow write: if isAdmin();
     }
     match /contact/{name} {
-      allow get: if true;
+      // Plan E: App Check enforced — see /singletons note above.
+      allow get: if request.app != null;
       allow list: if false;
       allow write: if isAdmin();
     }
-    match /social/{id}         { allow read: if true; allow write: if isAdmin(); }
-    match /experience/{id}     { allow read: if true; allow write: if isAdmin(); }
-    match /skills/{id}         { allow read: if true; allow write: if isAdmin(); }
-    match /education/{id}      { allow read: if true; allow write: if isAdmin(); }
-    match /certifications/{id} { allow read: if true; allow write: if isAdmin(); }
+    // Plan E: App Check enforced for the /about-page collections —
+    // see /singletons note above.
+    match /social/{id}         { allow read: if request.app != null; allow write: if isAdmin(); }
+    match /experience/{id}     { allow read: if request.app != null; allow write: if isAdmin(); }
+    match /skills/{id}         { allow read: if request.app != null; allow write: if isAdmin(); }
+    match /education/{id}      { allow read: if request.app != null; allow write: if isAdmin(); }
+    match /certifications/{id} { allow read: if request.app != null; allow write: if isAdmin(); }

     // ----- Settings (admin allowlist) — SERVER-ONLY writes.
     //       Reads via isAdmin() use get() which bypasses these rules at
     //       evaluation time. Client writes are disabled — only the seed
     //       script (firebase-admin) may modify the allowlist. Prevents an
     //       admin who steals their own token from adding accomplices.
     match /settings/{name} {
       allow read: if isAdmin();
       allow write: if false;
     }

-    // ----- Contact messages — locked until App Check ships in Plan E.
-    //       App Check is a hard prerequisite — without it, any caller can
-    //       spam /messages with garbage. Cloud Function from Plan E will
-    //       create messages server-side after verifying App Check.
+    // ----- Contact messages — Plan E opens client writes behind App
+    //       Check. The public contact form posts to /api/contact with
+    //       an `X-Firebase-AppCheck` header; the server verifies the
+    //       token AND the firestore.rules gate (`request.app != null`)
+    //       enforces it again at the DB layer (defence in depth).
     match /messages/{id} {
-      allow create: if false;
+      allow create: if request.app != null;
       allow get, list, update, delete: if isAdmin();
     }

     // ----- Audit log — server-only write (firebase-admin bypasses rules).
     //       Records every admin upsert. Read for admins only.
     match /audit/{id} {
