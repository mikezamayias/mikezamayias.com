#!/usr/bin/env sh

# Gitleaks secret scan (Plan B+ Task 7). Blocks commit on detection.
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --redact --no-banner || {
        echo "gitleaks detected secrets in staged changes — abort commit."
        exit 1
    }
else
    echo "[warn] gitleaks not installed — secret scan skipped. brew install gitleaks"
fi

bunx lint-staged
