{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun run snapshot && nuxt build",
        "dev": "nuxt dev",
        "generate": "bun run snapshot && NITRO_PRESET=static nuxt generate",
        "snapshot": "bun run scripts/snapshot-content.ts",
        "preview": "nuxt preview",
        "preview:static": "serve .output/public",
        "postinstall": "nuxt prepare",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:rules": "RULES_SUITE=1 firebase emulators:exec --only firestore,storage --project demo-codex 'RULES_SUITE=1 vitest run --fileParallelism=false tests/firestore tests/storage'",
        "seed:firestore": "bun run scripts/seed-firestore.ts",
        "seed:firestore:reset": "bun run scripts/seed-firestore.ts --reset",
        "migrate:collections": "bun run scripts/migrate-collections.ts",
        "migrate:collections:dry": "bun run scripts/migrate-collections.ts --dry-run",
        "drop:legacy:dry": "bun run scripts/drop-legacy-collections.ts --dry-run",
        "drop:legacy": "bun run scripts/drop-legacy-collections.ts",
        "prepare": "husky"
    },
    "devDependencies": {
        "@axe-core/cli": "^4.11.3",
        "@firebase/rules-unit-testing": "^5",
        "@nuxt/devtools": "^3.2.4",
        "@nuxt/eslint": "^1.15.2",
        "@nuxtjs/color-mode": "^4.0.0",
        "@nuxtjs/google-fonts": "^3.2.0",
        "@nuxtjs/i18n": "^10",
        "@nuxtjs/sitemap": "^7.6.0",
        "@nuxtjs/tailwindcss": "^6.14.0",
        "@types/sanitize-html": "^2.16.1",
        "@vitest/coverage-v8": "^4.1.0",
        "@vue/test-utils": "^2.4.6",
        "baseline-browser-mapping": "^2.10.8",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "firebase-admin": "^13.7.0",
        "firebase-tools": "^15.17.0",
        "happy-dom": "^20.8.4",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "nuxt": "^4.4.2",
        "prettier": "^3.8.1",
        "serve": "^14.2.6",
        "shadcn-nuxt": "^2.4.3",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0",
        "vue-tsc": "^3.2.6"
    },
    "lint-staged": {
        "*.{js,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,jsonc,md,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@fortawesome/fontawesome-svg-core": "^7.2.0",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@fortawesome/vue-fontawesome": "^3.1.3",
        "@jridgewell/sourcemap-codec": "^1.5.5",
        "@nuxt/kit": "^4.4.2",
        "@resvg/resvg-js": "^2.6.2",
        "@rollup/plugin-terser": "^1.0.0",
        "@sentry/nuxt": "^10.52.0",
        "@toast-ui/editor": "^3.2.2",
        "@vueuse/core": "^14.2.1",
        "better-sqlite3": "^12",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.4.2",
        "firebase": "^12.13.0",
        "firebase-functions": "^7.2.0",
        "lucide-vue-next": "^0.563.0",
        "marked": "14.1.4",
        "nuxt-security": "^2.5.1",
        "reka-ui": "^2.9.2",
        "sanitize-html": "^2.17.7",
        "satori": "^0.26.0",
        "tailwind-merge": "^3.5.0",
        "uqr": "^0.1.2",
        "vaul-vue": "^0.4.1",
        "vue-draggable-plus": "^0.6.1",
        "vue-sonner": "^2.0.9",
        "yaml": "^2.8.2",
        "zod": "^4.4.3"
    },
    "overrides": {
        "dompurify": "^3.2.0"
    }
}
