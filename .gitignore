# Local env files
.env
.env.*
# SOPS-encrypted env files are safe to commit (values are AES-encrypted via
# age recipients). Keep the `.sops.yaml` / `.sops.yml` files tracked; the
# blanket `.env.*` rule above would otherwise hide them.
!.env*.sops.yaml
!.env*.sops.yml

# Vitest coverage output (generated locally and in CI, no need to ship in repo)
coverage/

