{
    // Cloudflare Worker that serves mikezamayias.com.
    //
    // This file did not exist until now: the Worker was created and deployed
    // by hand with `wrangler deploy`, 13 times, with no configuration in the
    // repository. The values below were read back from the live Worker and
    // its routes so that `wrangler deploy` from a clean checkout reproduces
    // what is already running.
    //
    // The one deliberate difference: `not_found_handling` was unset (default
    // "none"), so unknown paths returned a zero-byte 404. "404-page" serves
    // the site's own prerendered 404.html instead.
    //
    // Do NOT use "single-page-application": that mode serves index.html with
    // a 200, so every unknown path would return the home page.
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "personal-website-v1",
    "account_id": "e2307e8414d6358345df0c4fa290ba08",
    "compatibility_date": "2026-06-20",
    // POST /api/contact is handled in the Worker. Dynamic admin URLs
    // (`/admin/work/<slug>`) are not prerendered. With compatibility_date
    // >= 2025-04-01, a browser navigation (Sec-Fetch-Mode: navigate) that
    // misses an asset is served 404.html and never invokes the Worker, so
    // the /admin shell fallback in worker/index.ts would not run.
    // `run_worker_first` opts those paths out of that shortcut. Static
    // admin pages still come from ASSETS inside the Worker (status 200).
    // `/api/*` is intentionally absent: contact is not an asset, so the
    // Worker already runs for it, and a site-wide API opt-in is not needed.
    "main": "worker/index.ts",
    // `html_handling` was unset, so it defaulted to "auto-trailing-slash".
    // Every prerendered route is a directory (`work/index.html`), so `/work`
    // 307'd to `/work/`. sitemap.xml advertises the slash-less form and Nuxt
    // routes without a trailing slash, so every indexed URL cost a redirect
    // and the post-deploy smoke test read those 307s as failures.
    // "drop-trailing-slash" serves `work/index.html` at `/work` directly and
    // redirects the other way, which is the form the rest of the site uses.
    "assets": {
        "binding": "ASSETS",
        "directory": ".output/public",
        "not_found_handling": "404-page",
        "html_handling": "drop-trailing-slash",
        "run_worker_first": ["/admin/*"],
    },
    "routes": [
        { "pattern": "mikezamayias.com/*", "zone_name": "mikezamayias.com" },
        { "pattern": "www.mikezamayias.com/*", "zone_name": "mikezamayias.com" },
    ],
}
