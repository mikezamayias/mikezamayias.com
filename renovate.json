{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:base", ":semanticCommits"],
    "schedule": ["before 6am on Monday"],
    "timezone": "Europe/Athens",
    "labels": ["dependencies"],
    "rangeStrategy": "bump",
    "packageRules": [
        {
            "matchPackagePatterns": ["^firebase", "^@firebase", "^nuxt-vuefire$"],
            "groupName": "firebase",
            "schedule": ["before 6am on Monday"]
        },
        {
            "matchPackagePatterns": ["^@nuxt", "^nuxt$", "^nitropack"],
            "groupName": "nuxt"
        },
        {
            "matchPackagePatterns": ["^@sentry"],
            "groupName": "sentry"
        },
        {
            "matchPackageNames": ["marked", "sanitize-html"],
            "automerge": false,
            "labels": ["dependencies", "security-audit-required"],
            "prBodyNotes": [
                ":warning: These are PIN-EXACT (no caret). Bumps require a regression test against the markdown sanitize allowlist before merge."
            ]
        },
        {
            "matchDepTypes": ["devDependencies"],
            "automerge": false,
            "schedule": ["before 6am on the first day of the month"]
        }
    ],
    "vulnerabilityAlerts": {
        "labels": ["security"],
        "schedule": ["at any time"]
    }
}
